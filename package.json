{
  "name": "potable",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "next dev",
    "dev:api": "tsx src/server/index.ts",
    "build": "prisma generate && next build",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "express": "4.19.2",
    "socket.io": "4.7.5",
    "socket.io-client": "4.7.5",
    "prisma": "5.14.0",
    "@prisma/client": "5.14.0",
    "zustand": "4.5.2",
    "zod": "3.23.8",
    "cors": "2.8.5"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "@types/node": "20.12.12",
    "@types/express": "4.17.21",
    "tsx": "4.11.0",
    "concurrently": "8.2.2",
    "tailwindcss": "3.4.3",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38"
  }
}